[Unit]
Description=MikroTik AI Assistant Service (Armbian STB)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mikrotik-ai-backend
ExecStart=/opt/mikrotik-ai-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
